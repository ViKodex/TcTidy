<?xml version="1.0" encoding="utf-8"?>
<!-- Restore everything under editors/vs from nuget.org only, whatever feeds the
     machine defines, so restores are reproducible. NuGet walks up from each
     project, so this covers the Core, its tests and the VS shell. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
