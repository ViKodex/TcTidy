<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="TcTidy.VsExtension.45a670ee-83ba-45e0-9ef7-25bc975f4406" Version="0.4.1" Language="en-US" Publisher="ViKodex" />
    <DisplayName>TcTidy for TwinCAT</DisplayName>
    <Description xml:space="preserve">Format TwinCAT Structured Text with tctidy: a "Format with TcTidy" command for POUs, folders and PLC projects in the Solution Explorer and for the element open in the PLC code editor, and a Formatting Settings page with a before/after preview. An independent project, not affiliated with or endorsed by Beckhoff Automation.</Description>
    <MoreInfo>https://github.com/ViKodex/TcTidy</MoreInfo>
    <License>LICENSE</License>
    <Tags>TwinCAT, Structured Text, IEC 61131-3, formatter, tctidy</Tags>
  </Metadata>
  <Installation>
    <!-- This payload is compiled against the Visual Studio 2022 toolkit for the 64-bit
         TwinCAT XAE Shell 17 generation. -->
    <InstallationTarget Id="Microsoft.VisualStudio.IntegratedShell" Version="[17.0,18.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
