<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <!-- Build one shell-specific VSIX at a time. XAE Shell 17 is the local default;
         release and compatibility gates build both values explicitly. -->
    <XaeShellVersion Condition="'$(XaeShellVersion)' == ''">17</XaeShellVersion>
    <XaeShellLabel>Xae$(XaeShellVersion)</XaeShellLabel>
    <MinimumVisualStudioVersion Condition="'$(XaeShellVersion)' == '15'">15.0</MinimumVisualStudioVersion>
    <MinimumVisualStudioVersion Condition="'$(XaeShellVersion)' == '17'">17.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{45a670ee-83ba-45e0-9ef7-25bc975f4406}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>TcTidy.VsExtension</RootNamespace>
    <AssemblyName>TcTidy.VsExtension</AssemblyName>
    <!-- Match each toolkit's supported framework while keeping XAE Shell 15 on its
         original .NET Framework floor. -->
    <TargetFrameworkVersion Condition="'$(XaeShellVersion)' == '15'">v4.7.2</TargetFrameworkVersion>
    <TargetFrameworkVersion Condition="'$(XaeShellVersion)' == '17'">v4.8</TargetFrameworkVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <!-- Disable the VSSDK compatibility analyzer: it assumes a single modern VS target
         and false-positives on a deliberately multi-target extension, flagging the
         universally-available interop assemblies (Shell.Interop, OLE.Interop, …) that the
         VS 2017-baseline toolkit references. Real compatibility is covered by the payload
         checks (scripts/release/validate-vsix.ps1) and manual testing in each XAE Shell. -->
    <CompatibilitySeverity></CompatibilitySeverity>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <!-- Don't drag a referenced project's sidecar .pdb/.xml into the output (and thus the
         .vsix); the Core ships as a DLL only, matching this project's no-symbols policy. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\$(XaeShellLabel)\</OutputPath>
    <IntermediateOutputPath>obj\Debug\$(XaeShellLabel)\</IntermediateOutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\$(XaeShellLabel)\</OutputPath>
    <IntermediateOutputPath>obj\Release\$(XaeShellLabel)\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Commands\FormatElementCommand.cs" />
    <Compile Include="Commands\FormatPouCommand.cs" />
    <Compile Include="Commands\FormatSupport.cs" />
    <Compile Include="Commands\MenuCommands.cs" />
    <Compile Include="Commands\TogglePerfReportCommand.cs" />
    <Compile Include="Commands\ToggleUpdateCheckCommand.cs" />
    <Compile Include="OpenDocs.cs" />
    <Compile Include="Options\GeneralOptions.cs" />
    <Compile Include="PerfMode.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SourceFiles.cs" />
    <Compile Include="TcTidyOutput.cs" />
    <Compile Include="TcTidyPackage.cs" />
    <Compile Include="UpdateNotifier.cs" />
    <Compile Include="VSCommandTable.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.xae15.extension.vsixmanifest" Condition="'$(XaeShellVersion)' == '15'">
      <SubType>Designer</SubType>
    </None>
    <None Include="source.extension.vsixmanifest" Condition="'$(XaeShellVersion)' == '17'">
      <SubType>Designer</SubType>
    </None>
    <SourceVsixManifest Include="source.xae15.extension.vsixmanifest"
                        Condition="'$(XaeShellVersion)' == '15'" />
    <SourceVsixManifest Include="source.extension.vsixmanifest"
                        Condition="'$(XaeShellVersion)' == '17'" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <!-- Merge the compiled .cto into a managed resources container named "VSPackage"
         (VSPackage.resources), the container the shell consults for THIS managed
         package's Menus.ctmenu. Without this, the VSSDK falls back to
         "_EmptyResource.resources", which the shell never reads for the package, so
         the command table is never merged and the command silently never appears. -->
    <EmbeddedResource Include="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Bundle the tctidy formatter binary next to the extension when present (CI drops it here
         at release time; *.exe is git-ignored). The Condition keeps the no-exe dev build green;
         the command locates it at runtime next to the assembly (Assembly.Location). -->
    <Content Include="tctidy.exe" Condition="Exists('tctidy.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- The third-party license notices for the crates linked into tctidy.exe, so the
         attribution ships inside the .vsix (and thus the installer) next to the binary.
         Same pattern as tctidy.exe: CI drops it here at release time (it's git-ignored),
         and the Condition keeps the no-notices dev build green. -->
    <Content Include="THIRD-PARTY-NOTICES.md" Condition="Exists('THIRD-PARTY-NOTICES.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="CARGO-DEPENDENCIES.json" Condition="Exists('CARGO-DEPENDENCIES.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- The tracked attribution of the NuGet components the extension redistributes
         (Community.VisualStudio.Toolkit), next to the generated Cargo notices. -->
    <Content Include="THIRD-PARTY-NOTICES-EXTENSION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- The summary the VSIX installer displays (the manifest's License), and the two
         license texts it points to. -->
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\..\LICENSE-MIT">
      <Link>LICENSE-MIT</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\..\LICENSE-APACHE">
      <Link>LICENSE-APACHE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="THIRD-PARTY-INVENTORY.xae15.json" Condition="'$(XaeShellVersion)' == '15'">
      <Link>THIRD-PARTY-INVENTORY.json</Link>
      <TargetPath>THIRD-PARTY-INVENTORY.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="THIRD-PARTY-INVENTORY.json" Condition="'$(XaeShellVersion)' == '17'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- The thin shell consumes the tested, VS-independent Core. Copy its DLL next to the
         assembly (Private) and pack it into the .vsix (IncludeOutputGroupsInVSIX); net472
         loads the netstandard2.0 Core natively, so no facade assemblies are needed. The
         <Project> GUID lets this old-style project resolve the SDK-style reference. -->
    <ProjectReference Include="..\TcTidy.VsExtension.Core\TcTidy.VsExtension.Core.csproj">
      <Project>{7b3f9c12-8e4a-4d6b-a1c5-2f9e0d3b6a84}</Project>
      <Name>TcTidy.VsExtension.Core</Name>
      <Private>true</Private>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.15" Version="15.0.551"
                      Condition="'$(XaeShellVersion)' == '15'" />
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551"
                      Condition="'$(XaeShellVersion)' == '17'" />
    <!-- Visual Studio supplies this host SDK assembly. Keep it available for
         compilation without copying it into the VSIX payload. -->
    <PackageReference Include="Microsoft.VisualStudio.DpiAwareness" Version="6.0.28727">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="ValidateXaeShellVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(XaeShellVersion)' != '15' and '$(XaeShellVersion)' != '17'"
           Text="XaeShellVersion must be 15 or 17." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
